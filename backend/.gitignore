# ==========================================
# 1. DEPENDENCIES (Thư viện)
# ==========================================
node_modules/
/.pnp
.pnp.js

# ==========================================
# 2. BUILD & COMPILED FILES (File biên dịch)
# ==========================================
# Thư mục chứa code sau khi build từ TypeScript sang JavaScript
dist/
build/
out/
# File cache của TypeScript để tăng tốc độ build
*.tsbuildinfo

# ==========================================
# 3. ENVIRONMENT & SECRETS (Mật khẩu & Cấu hình) 🚨 QUAN TRỌNG
# ==========================================
# Tuyệt đối không commit các file .env
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Khóa bảo mật (Service accounts, certificates)
firebase-service-account.json
*.pem
*.key
*.cert

# ==========================================
# 4. LOGS & DATABASES (Lịch sử & Dữ liệu nội bộ)
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dữ liệu local của Docker (nếu bạn map volume ra máy tính)
postgres_data/
redis_data/
*.sqlite

# ==========================================
# 5. TESTING & COVERAGE
# ==========================================
coverage/
.nyc_output/

# ==========================================
# 6. OS & IDE (Hệ điều hành & Code Editor)
# ==========================================
# Mac / Windows
.DS_Store
Thumbs.db

# VS Code / WebStorm
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?